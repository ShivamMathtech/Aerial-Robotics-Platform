# Leave blank for local-only development. Set a strong key before exposing a server.
API_KEY=
DATABASE_URL=sqlite:///./aerial.db
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:8080,http://127.0.0.1:8080
LOG_LEVEL=INFO
# Docker Compose PostgreSQL password: required for docker compose up.
POSTGRES_PASSWORD=
